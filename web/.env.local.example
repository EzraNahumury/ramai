# Copy to .env.local and fill. Values prefixed NEXT_PUBLIC_ are exposed to the browser.

# Privy — create an app at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=

# BNB Smart Chain Testnet
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Deployed contract addresses (fill after `pnpm deploy:testnet` in ../contracts)
NEXT_PUBLIC_RAMAI_EVENTS_ADDRESS=
NEXT_PUBLIC_RAMAI_REPUTATION_ADDRESS=

# Supabase (server-only) — create a project at https://supabase.com, run supabase/schema.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
